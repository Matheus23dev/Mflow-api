# Supabase Session pooler (porta 5432), adequado ao Render
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Opcional para comandos Prisma locais: conexão direta do Supabase
DIRECT_URL=""
# Alternativa ao arquivo prisma/supabase-ca.crt
SUPABASE_DATABASE_CA=""
JWT_SECRET="change-this-secret-in-production"
# Proteção da API: limite padrão por IP a cada minuto
API_RATE_LIMIT_PER_MINUTE="120"
# Cloudflare R2 privado (bucket exclusivo para comprovantes)
R2_ACCOUNT_ID="seu-account-id"
R2_ACCESS_KEY_ID="sua-access-key"
R2_SECRET_ACCESS_KEY="sua-secret-key"
R2_BUCKET_NAME="mflow-comprovantes"
# Opcional: webhook recebe apenas alertas de espaço, nunca os arquivos
DISCORD_RECEIPTS_WEBHOOK_URL=""
# Opcional: se vazio, os alertas do banco usam o webhook acima
DISCORD_ALERTS_WEBHOOK_URL=""
# O sistema nunca aceita valor acima de 9 GB, mesmo se configurado maior
RECEIPTS_WARNING_BYTES="8000000000"
RECEIPTS_CRITICAL_BYTES="8500000000"
RECEIPTS_HARD_LIMIT_BYTES="9000000000"
# Links privados de leitura expiram rapidamente e não usam a banda do Render
RECEIPT_SIGNED_URL_TTL_SECONDS="60"
# Alertas antes do limite gratuito de 500 MB do Supabase
DATABASE_WARNING_BYTES="350000000"
DATABASE_CRITICAL_BYTES="425000000"
DATABASE_DANGER_BYTES="475000000"
