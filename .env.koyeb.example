DATABASE_URL="mysql://USUARIO:SENHA@HOST:PORTA/defaultdb"
DATABASE_CA="-----BEGIN CERTIFICATE-----\nCOLE_O_CERTIFICADO_CA_DO_AIVEN\n-----END CERTIFICATE-----"
