DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
# Opcional quando prisma/supabase-ca.crt estiver incluído no deploy
SUPABASE_DATABASE_CA=""
JWT_SECRET=GERADO_AUTOMATICAMENTE_PELO_RENDER
# Cloudflare R2 privado (bucket exclusivo para comprovantes)
R2_ACCOUNT_ID="seu-account-id"
R2_ACCESS_KEY_ID="sua-access-key"
R2_SECRET_ACCESS_KEY="sua-secret-key"
R2_BUCKET_NAME="mflow-comprovantes"
# Opcional: webhook recebe apenas alertas de espaço, nunca os arquivos
DISCORD_RECEIPTS_WEBHOOK_URL=""
# O sistema nunca aceita valor acima de 9 GB, mesmo se configurado maior
RECEIPTS_WARNING_BYTES="8000000000"
RECEIPTS_CRITICAL_BYTES="8500000000"
RECEIPTS_HARD_LIMIT_BYTES="9000000000"
FRONTEND_URL=https://seu-frontend.vercel.app
